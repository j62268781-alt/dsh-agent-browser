{
  "name": "dsh-agent-browser",
  "version": "0.1.0",
  "description": "DSH plugin for browser automation: narrow agent-browser CLI (Rust + CDP) tool surface, in-page DOM candidate extraction, settings self-check UI, and a low-cost Jev + upstream LLM bounded decision loop (browser_run).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis-plugin",
    "browser-automation",
    "agent-browser",
    "cdp",
    "judgment"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "pnpm build:host && pnpm build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node client/esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "probe": "pnpm build:host && node scripts/probe.mjs",
    "verify:remote": "pnpm build && node scripts/verify-remote.mjs",
    "verify:served": "node scripts/verify-served.mjs",
    "e2e": "pnpm build && node scripts/e2e-run.mjs",
    "try": "node scripts/try.mjs",
    "live": "node scripts/live-profile.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:vote": "node scripts/bench-vote.mjs",
    "bench:tasks": "node bench/run.mjs",
    "bench:tasks:offline": "node bench/run.mjs --tier offline",
    "bench:report": "node bench/report.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "dsh-judgment": ">=0.1.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "dsh-judgment": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "dsh-judgment": "file:../dsh-judgment",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0"
  }
}
